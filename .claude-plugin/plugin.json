{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "givmo",
  "displayName": "Givmo Giving",
  "version": "0.1.0",
  "description": "Search real charities and read your own linked Givmo giving. The agent never moves money; payment happens only on Givmo's own checkout page, which is not available yet.",
  "author": {
    "name": "Givmo",
    "url": "https://givmo.io"
  },
  "homepage": "https://givmo.io",
  "repository": "https://github.com/givfi/givmo-cli",
  "license": "Apache-2.0",
  "keywords": [
    "charity",
    "charitable-giving",
    "donation",
    "nonprofit",
    "mcp",
    "givmo"
  ],
  "mcpServers": {
    "givmo": {
      "type": "http",
      "url": "https://mcp.givmo.io/mcp"
    }
  }
}
